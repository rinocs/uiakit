COMPOSE_PROJECT_NAME=uai
UAI_BIND_ADDRESS=127.0.0.1
UAI_PORT=8080
# Hex secrets only: safe in the PostgreSQL URL. Generate using README commands.
# Every secret supports a mounted-file variant (for example
# INTERNAL_API_KEY_FILE=/run/secrets/internal_api_key). Never set both.
POSTGRES_PASSWORD=
INTERNAL_API_KEY=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Bootstrap admin: store only SHA-256; clients keep original key.
# May be emptied AFTER creating/verifying a persistent admin key (docs/auth.md).
UAI_API_KEY_SHA256=
MODEL_BASE_URL=http://ollama:11434/v1
MODEL_NAME=llama3.2:3b
MODEL_API_KEY=
# Optional key for hosted embedding providers.
EMBEDDING_API_KEY=
MODEL_MAX_TOKENS=1024
# Installation-wide request limit per minute.
UAI_RATE_LIMIT=120
# Per-principal request limit per minute (bounded in-memory windows).
UAI_RATE_LIMIT_PER_PRINCIPAL=120
# Outbound host:port allowlist for model, embedding and isolated-plugin
# endpoints (for example api.openai.com:443). Empty denies every outbound
# provider endpoint; unset disables the allowlist check.
UAI_EGRESS_ALLOW=ollama:11434
# Exact browser origins allowed for widget SSE (comma-separated); empty disables.
UAI_WIDGET_ORIGINS=
# Dedicated per-widget-token request budget per minute.
UAI_WIDGET_RATE_LIMIT=60
# Days; 0 disables automatic retention for that data class.
UAI_RETENTION_CONVERSATION_DAYS=0
UAI_RETENTION_AUDIT_DAYS=0
UAI_RETENTION_APPROVAL_DAYS=0
UAI_RETENTION_CLEANUP_DAYS=0
# Optional OTLP/HTTP collector endpoint (base URL, without /v1/traces).
UAI_OTEL_ENDPOINT=
# Optional USD prices per 1M tokens for the uai.cost metric.
UAI_MODEL_COST_INPUT_PER_MILLION=
UAI_MODEL_COST_OUTPUT_PER_MILLION=
# Minimal admin console (SvelteKit); credentials are entered at login.
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=3000
CONSOLE_ORIGIN=http://localhost:3000
MODEL_PROVIDER=openai-compatible
OLLAMA_BASE_URL=http://ollama:11434
# CSV connector IDs allowed for HTTP tools; empty denies every connector-bound tool.
TOOL_ALLOWED_CONNECTORS=
# Enable only for models that support OpenAI-compatible tool calls.
MODEL_TOOL_CALLING=false
# Enable only when the provider supports JSON-schema structured output.
MODEL_STRUCTURED_OUTPUT=false
# Optional context window (tokens) used to prevent over-window requests.
MODEL_CONTEXT_WINDOW=
# Optional isolated HTTP plugin. Deploy the isolated-plugin image and include
# its connector ID in TOOL_ALLOWED_CONNECTORS.
ISOLATED_PLUGIN_URL=
ISOLATED_PLUGIN_TOKEN=
ISOLATED_PLUGIN_MANIFEST=
# Extra console origins allowed for form posts (comma-separated), e.g. LAN IP
# or mDNS hostname alternates of CONSOLE_ORIGIN.
CSRF_TRUSTED_ORIGINS=
