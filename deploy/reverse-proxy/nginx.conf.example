# Example TLS terminator in front of the gateway. Mount certificates from a
# secret manager at /run/secrets/tls.crt and /run/secrets/tls.key.
#
# Do not add wildcard CORS here: the gateway owns the exact widget-origin
# allowlist and adds no CORS headers for server-side clients.
# Do not forward to the runtime, database or Qdrant: only the gateway is public.
server {
    listen 80;
    server_name gateway.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name gateway.example.com;

    ssl_certificate     /run/secrets/tls.crt;
    ssl_certificate_key /run/secrets/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # 20 MiB uploads plus multipart overhead.
    client_max_body_size 21m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # SSE must not be buffered; the gateway enforces its own run timeout.
    proxy_buffering off;
    proxy_read_timeout 150s;

    location / {
        proxy_pass http://gateway:8080;
    }
}
