{
  "name": "@universal-ai-kit/console",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../../packages/sdk-typescript run build",
    "dev": "vite dev",
    "prebuild": "npm --prefix ../../packages/sdk-typescript run build",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "npm run sync && svelte-check --tsconfig ./tsconfig.json && vitest run && npm run build",
    "test": "vitest run",
    "precheck": "npm --prefix ../../packages/sdk-typescript run build",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@universal-ai-kit/sdk": "file:../../packages/sdk-typescript"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
