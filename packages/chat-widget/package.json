{
  "name": "@universal-ai-kit/chat-widget",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Framework-agnostic Web Component chat widget for Universal AI Kit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm --prefix ../sdk-typescript run build",
    "test": "node --test tests/*.test.ts",
    "check": "npm run pretest && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@universal-ai-kit/sdk": "file:../sdk-typescript"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
