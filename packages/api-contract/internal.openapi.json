  "components": {
    "schemas": {
      "AssistantConfig": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "title": "Description",
            "default": ""
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "system_prompt": {
            "type": "string",
            "maxLength": 16000,
            "title": "System Prompt"
          },
          "directives": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Directives",
            "default": []
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools",
            "default": []
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "default": []
          },
          "knowledge_base_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Knowledge Base Ids",
            "default": []
          },
          "memory": {
            "$ref": "#/components/schemas/MemoryConfig"
          },
          "limits": {
            "$ref": "#/components/schemas/ExecutionLimits"
          },
          "policy": {
            "$ref": "#/components/schemas/AssistantPolicy"
          },
          "structured_output": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Structured Output"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "model",
          "system_prompt"
        ],
        "title": "AssistantConfig"
      },
      "AssistantPolicy": {
        "properties": {
          "require_tool_approval": {
            "type": "boolean",
            "title": "Require Tool Approval",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AssistantPolicy"
      },
      "DirectiveSelection": {
        "properties": {
          "directives": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Directives"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "directives"
        ],
        "title": "DirectiveSelection"
      },
      "ExecutionAuthority": {
        "properties": {
          "principal_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Principal Id"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true,
            "title": "Scopes",
            "default": []
          },
          "allowed_tool_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true,
            "title": "Allowed Tool Ids",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "principal_id"
        ],
        "title": "ExecutionAuthority"
      },
      "ExecutionLimits": {
        "properties": {
          "max_input_chars": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Input Chars",
            "default": 64000
          },
          "max_output_chars": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Output Chars",
            "default": 64000
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Duration Seconds",
            "default": 120
          },
          "max_steps": {
            "type": "integer",
            "maximum": 16.0,
            "minimum": 0.0,
            "title": "Max Steps",
            "default": 4
          },
          "max_tool_calls": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 0.0,
            "title": "Max Tool Calls",
            "default": 8
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Max Tokens",
            "default": 8192
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExecutionLimits"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonValue": {},
      "MemoryConfig": {
        "properties": {
          "conversation": {
            "type": "boolean",
            "title": "Conversation",
            "default": true
          },
          "semantic": {
            "type": "boolean",
            "title": "Semantic",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MemoryConfig"
      },
      "Message": {
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "user"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "maxLength": 32000
                }
              }
            }
          }
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 64000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "ModelDefinition-Input": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "const": "openai-compatible",
            "title": "Provider",
            "default": "openai-compatible"
          },
          "capabilities": {
            "items": {
              "type": "string",
              "enum": [
                "chat",
                "streaming",
                "tool_calling",
                "structured_output",
                "embeddings",
                "reranking",
                "vision"
              ]
            },
            "type": "array",
            "uniqueItems": true,
            "title": "Capabilities"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens"
          },
          "context_window": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "capabilities"
        ],
        "title": "ModelDefinition"
      },
      "ModelDefinition-Output": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "const": "openai-compatible",
            "title": "Provider",
            "default": "openai-compatible"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens"
          },
          "context_window": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "capabilities"
        ],
        "title": "ModelDefinition"
      },
      "PluginConfiguration": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "settings": {
            "patternProperties": {
              "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {
                "$ref": "#/components/schemas/PluginSetting"
              }
            },
            "propertyNames": {
              "maxLength": 200
            },
            "type": "object",
            "maxProperties": 64,
            "title": "Settings"
          }
        },
